# Copy this file to .env.local. Docker Compose overrides DATABASE_URL for its DB service.
DATABASE_URL=postgresql://lotterylunch:devpass@localhost:5432/lotterylunch

# Optional: Prisma can create a shadow database when its user has CREATEDB permission.
# SHADOW_DATABASE_URL=postgresql://lotterylunch:devpass@localhost:5432/lotterylunch_shadow

BETTER_AUTH_URL=http://localhost:3000
# Browser authentication uses the current origin. A separate auth host can
# optionally be set with NEXT_PUBLIC_BETTER_AUTH_URL before building.
# Generate a value with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth credentials. Register http://localhost:3000/api/auth/callback/google
# and http://localhost:3000/api/v1/calendar/connections/google/callback as redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
